# Apache configuration for the Hetzner webroot.
#
# It does nothing on GitHub Pages — Pages ignores .htaccess and can set no headers
# at all, which is one of the reasons for moving. Every block is wrapped in an
# IfModule so a host without the module serves the site instead of a 500.

# ─── Directory listings ──────────────────────────────────────────────────────
# Without this, /assets/downloads/ and /assets/audio/ are browsable index pages.
Options -Indexes

# ─── HTTPS ───────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ─── Headers ─────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # The page loads nothing from anywhere else: both webfonts, all four platform
  # glyphs, the photograph and the audio are in assets/, and the live dates are a
  # local JSON file. So 'self' everywhere is not a restriction, it is a description
  # — and it stays one only as long as that is true. Adding a CDN or an embed means
  # editing this line, which is the point.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

  # The footer links out to Spotify, Apple Music, Deezer, Instagram and Bandsintown.
  # no-referrer means none of them learn which page the visitor came from. Same
  # reasoning as fetching the live dates on a runner: remove the data flow rather
  # than document it.
  Header always set Referrer-Policy "no-referrer"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # No includeSubDomains and no preload: the domain carries mail, and a year-long
  # blanket promise for every subdomain is not this site's to make. Add them only
  # after checking that every subdomain really does speak HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # The live dates are rewritten hourly by CI. A long cache here would show a gig
  # that has already been played, or hide one that was just announced — the whole
  # point of the hourly job, undone by a caching header.
  <FilesMatch "gigs\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Filenames carry no content hash, so a long cache serves the old file after a
  # deploy. Markup and code revalidate; the heavy, rarely-touched assets do not.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpg|png|svg|woff2|ttf|mp3|gif|pdf|zip)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ─── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
  # woff2 and the photographs are already compressed; gzipping them costs CPU and
  # gains nothing.
</IfModule>

# ─── MIME types ──────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType audio/mpeg .mp3
</IfModule>

# ─── Belt and braces ─────────────────────────────────────────────────────────
# .deployignore already keeps these off the server. This is the second lock, for
# the day someone copies the folder up by hand.
<FilesMatch "(^\.|^README\.md$)">
  Require all denied
</FilesMatch>
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(\.git|\.github|tools)(/|$)
</IfModule>

# ─── Pre-launch password ─────────────────────────────────────────────────────
# Uncomment for the window between "the site is on Hetzner" and "the site is
# public". This is a real lock, unlike js/gate.js: it is checked before Apache
# serves a single byte, so there is no password in anything the visitor receives.
#
# Create the file outside the webroot:
#   htpasswd -c /usr/home/<user>/.htpasswd <name>
#
# AuthType Basic
# AuthName "keine Panik."
# AuthUserFile /absolute/path/to/.htpasswd
# Require valid-user
